PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://connany:connany@localhost:54329/connany
# Generate: openssl rand -base64 32 ; keep stable across restarts and back it up.
TOKEN_ENCRYPTION_KEY=
# Configure connectors in /admin. Values below are optional one-time legacy imports.
# After import, database settings take precedence; changing these values does not update saved secrets.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_API_VERSION=2026-03-10
# The SDK defaults to read-only tools; enable writes explicitly in your backend.
# Local development behind a proxy in fake-IP mode (every name resolves to 198.18.0.0/15):
# let custom MCP servers through. Never set it on a server.
# CUSTOM_MCP_ALLOW_FAKE_IP=true
