{
  "name": "connany",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "project:create": "tsx --env-file-if-exists=.env scripts/create-project.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "setup": "tsx scripts/init-env.ts",
    "example:agent": "tsx --env-file-if-exists=.env examples/agent.ts",
    "test:browser": "tsx --test tests/browser/*.test.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "opencc-js": "^1.4.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
